{
  "name": "track-expense-v2-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "test:rules:emulator": "cd .. && firebase emulators:exec --only firestore --project demo-track-expense \"npm --prefix functions run test:rules\"",
    "eval": "tsx eval/run.ts",
    "migrate": "tsx src/scripts/migrate-v1-to-v2.ts"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.44.0",
    "@genkit-ai/vertexai": "^1.44.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "genkit": "^1.44.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
