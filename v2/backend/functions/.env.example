# Copy to functions/.env (all projects) or functions/.env.<projectId>. No secrets belong here.

# Agent model: vertexai/<gemini>, vertex-model-garden/<claude>, or googleai/<gemini> (needs GEMINI_API_KEY).
AGENT_MODEL=vertexai/gemini-3.8-flash

# Vertex AI location for Gemini + embeddings, and for Model Garden (Claude).
VERTEX_LOCATION=us-central1
MODEL_GARDEN_LOCATION=us-east5

# Optional: a model used only to reword insight cards. Empty = deterministic templates.
INSIGHTS_PHRASING_MODEL=

# Time zone for the daily insights job.
DEFAULT_TIME_ZONE=Asia/Kolkata

# Set to true once the apps ship App Check.
ENFORCE_APP_CHECK=false
